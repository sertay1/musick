<Window x:Class="MusicBot.Desktop.LogViewerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Musick — Etkinlik ve Tanılama" Width="1040" Height="660" MinWidth="760" MinHeight="420"
 WindowStartupLocation="CenterScreen" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}">
 <Window.Resources>
  <SolidColorBrush x:Key="Surface" Color="#15181D"/>
  <SolidColorBrush x:Key="Text" Color="#E5E7EB"/>
  <SolidColorBrush x:Key="Panel" Color="#20252D"/>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4,0"/><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="{DynamicResource Panel}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock Text="Etkinlik ve tanılama" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Bağlantı, oynatma ve uygulama sorunlarını burada izleyebilirsiniz." Margin="0,5,0,0" Opacity="0.7"/></StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,12">
   <Button DockPanel.Dock="Right" Content="Görünümü temizle" Click="OnClear"/>
   <Button DockPanel.Dock="Right" Content="Görünenleri kopyala" Click="OnCopy"/>
   <ComboBox x:Name="LevelFilter" DockPanel.Dock="Right" Width="140" SelectedIndex="0" SelectionChanged="OnFilterChanged" Margin="6,0"><ComboBoxItem Content="Bilgi ve üzeri"/><ComboBoxItem Content="Uyarı ve hatalar"/><ComboBoxItem Content="Yalnızca hatalar"/><ComboBoxItem Content="Tüm seviyeler"/></ComboBox>
   <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" ToolTip="Mesajlarda ara"/>
  </DockPanel>
  <ListBox Grid.Row="2" x:Name="EntriesBox" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="6"/></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Time}" Opacity="0.6" Margin="0,0,12,0"/><TextBlock Text="{Binding Severity}" FontWeight="Bold" Margin="0,0,12,0"/><TextBlock Text="{Binding Category}" Opacity="0.7"/></StackPanel><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding Details}" TextWrapping="Wrap" Opacity="0.65" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <DockPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="StatusText" DockPanel.Dock="Left"/><CheckBox x:Name="PauseUpdates" DockPanel.Dock="Right" Content="Akışı duraklat" Margin="16,0,0,0"/><CheckBox x:Name="Technical" DockPanel.Dock="Right" Content="HTTP ayrıntıları" Checked="OnCheckChanged" Unchecked="OnCheckChanged" Margin="16,0,0,0"/><CheckBox x:Name="AutoScroll" DockPanel.Dock="Right" Content="Sona kaydır" IsChecked="True"/></DockPanel>
 </Grid>
</Window>
