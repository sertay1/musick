<Window x:Class="MusicBot.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Musick"
        Width="1360" Height="860"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="{DynamicResource CaptionBackground}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="CaptionBackground" Color="#171815" />
        <SolidColorBrush x:Key="CaptionText" Color="#B2B1A7" />
        <SolidColorBrush x:Key="CaptionBorder" Color="#34352F" />
        <SolidColorBrush x:Key="CaptionHover" Color="#282925" />
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="45" /><Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource CaptionText}" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Focusable" Value="False" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource CaptionHover}" /></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Border x:Name="WindowFrame" BorderThickness="1" BorderBrush="{DynamicResource CaptionBorder}" Background="{DynamicResource CaptionBackground}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Background="{DynamicResource CaptionBackground}">
            <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" Width="20" Height="20" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Musick" Foreground="{DynamicResource CaptionText}" FontSize="11" Margin="38,0,0,0" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Küçült" AutomationProperties.Name="Küçült"><Path Data="M0,5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" /></Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="OnMaximizeRestore" ToolTip="Büyüt / Geri yükle" AutomationProperties.Name="Büyüt / Geri yükle"><Path x:Name="MaximizeGlyph" Data="M0,0 H10 V10 H0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" /></Button>
                <Button x:Name="CloseButton" Click="OnCaptionClose" ToolTip="Kapat" AutomationProperties.Name="Kapat"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C94F43" /><Setter Property="Foreground" Value="White" /></Trigger></Style.Triggers></Style></Button.Style><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" /></Button>
            </StackPanel>
            <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource CaptionBorder}" IsHitTestVisible="False" />
        </Grid>
        <wv2:WebView2 x:Name="WebView" Grid.Row="1" />

        <!-- Loading overlay — hidden once WebView navigates -->
        <Border x:Name="LoadingOverlay"
                Grid.Row="1"
                Background="#191A18"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="♫"
                           FontSize="48"
                           Foreground="#B1D775"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>
                <TextBlock Text="Musick Başlatılıyor…"
                           FontSize="16"
                           Foreground="#B2B1A7"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
