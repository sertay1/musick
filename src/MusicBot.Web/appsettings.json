{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=musicbot.db"
  },
  "Spotify": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "http://127.0.0.1:3050/api/auth/spotify/callback"
  },
  "Queue": {
    "MaxSize": 50,
    "MaxSongsPerUser": 10,
    "VotingEnabled": false,
    "PresenceCheckEnabled": false,
    "LoudnessNormalizationEnabled": true,
    "DirectSpotifyMode": true
  },
  "MusicLibrary": {
    "LibraryPath": "music-library",
    "YtDlpPath": "yt-dlp",
    "UseNativeAudioFormat": true
  },
  "Kick": {
    "Channel": "",
    "UserSlug": "",
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "http://localhost:3050/api/auth/kick/callback"
  },
  "Desktop": {
    "OpenLogOnStart": false
  },
  "GoogleOAuth": {
    "ClientId": "",
    "ClientSecret": ""
  }
}
